console=ttymxc0,115200

bootlimit=5
upgrade_available=0
bootcount=0

altbootcmd=
    echo "Boot count exceeded bootlimit, rolling back eMMC boot partition";
    setenv bootcount 0;
    setenv upgrade_available 0;
    saveenv;
    if test "${emmc_boot_part}" = "boot0"; then
        mmc partconf 2 1 2 2;
        reset;
    else
        if test "${emmc_boot_part}" = "boot1"; then
            mmc partconf 2 1 1 1;
            reset;
        else
            echo "Booted from SD card (single bootloader, no boot0/boot1) - entering fastboot rescue mode";
            fastboot 0;
        fi;
    fi;

dofastboot=0

fastboot_dev=mmc
fastboot_mmc_dev=2
fastboot_raw_partition_all=0 8388608
fastboot_raw_partition_bootloader=64 8128
fdtoverlay_addr_r=0x49000000
fdt_addr_r=0x48000000

ip_dyn=yes

kernel_addr_r=0x5A080000
kernel_comp_addr_r=0x60000000
kernel_comp_size=0x2000000

emmc_boot_part=user

mmcautodetect=no

# This is needed by built-in uuu flash scripts
emmc_dev=2
sd_dev=1
# this is relevant to set default if we boot from SD card
mmcroot=2

pxefile_addr_r=0x58600000
ramdisk_addr_r=0x5E000000
scriptaddr=0x40000000
bootenv_addr_r=0x49100000

bootcmd=
    if test ${dofastboot} = 1; then
        fastboot 0;
    fi;
    if ext4load mmc ${mmcdev}:${mmcroot} ${scriptaddr} /boot/boot.scr.uimg; then
        source ${scriptaddr}:script;
    else
        echo "ERROR: Active Boot-Script not found on partition ${mmcroot}!";
    fi;
